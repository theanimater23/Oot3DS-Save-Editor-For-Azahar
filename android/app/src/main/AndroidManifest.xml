<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No storage permissions are declared on purpose. The Storage Access Framework
      (ACTION_OPEN_DOCUMENT / persisted URI permissions used in MainActivity) works
      without them on Android 11+, which is what this app targets. That also means
      no scoped-storage restrictions block reading or writing the exact save file
      the person picks, in Azahar's folder or anywhere else.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.OoT3DSaveEditor"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
